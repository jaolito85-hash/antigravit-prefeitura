# Supabase (Projeto separado para prefeituras)
SUPABASE_URL=your_supabase_url
SUPABASE_KEY=your_supabase_anon_key

# Evolution API (WhatsApp)
EVOLUTION_API_URL=your_evolution_url
EVOLUTION_API_KEY=your_evolution_key
EVOLUTION_INSTANCE_NAME=your_instance

# OpenAI
# Use modelos NÃO-reasoning (rápidos, devolvem texto direto). Modelos de
# raciocínio (gpt-5*) ficam lentos e podem devolver resposta vazia aqui.
# Os nomes das variáveis DEVEM ser estes (o código não lê "OPENAI_MODEL").
OPENAI_API_KEY=your_openai_key
OPENAI_MODEL_CITIZEN_REPLY=gpt-4o-mini
OPENAI_MODEL_CLASSIFIER=gpt-4o-mini
OPENAI_MODEL_INTERNAL_DRAFT=gpt-4o-mini
OPENAI_MODEL_MODERATION=omni-moderation-latest

# Server
PORT=5002

# Dashboard Login
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=sua_senha_forte_aqui
FLASK_SECRET_KEY=gere_uma_chave_aleatoria_aqui

# Admin API
ADMIN_KEY=sua_chave_admin_aqui

# Webhook (mesmo valor configurado na Evolution API)
WEBHOOK_SECRET=sua_chave_webhook_aqui
