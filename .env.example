# Supabase (Projeto separado para prefeituras)
SUPABASE_URL=your_supabase_url
SUPABASE_KEY=your_supabase_anon_key

# Evolution API (WhatsApp)
EVOLUTION_API_URL=your_evolution_url
EVOLUTION_API_KEY=your_evolution_key
EVOLUTION_INSTANCE_NAME=your_instance

# OpenAI
# Use modelos NÃO-reasoning (rápidos, devolvem texto direto). Modelos de
# raciocínio (gpt-5*) ficam lentos e podem devolver resposta vazia aqui.
# Os nomes das variáveis DEVEM ser estes (o código não lê "OPENAI_MODEL").
OPENAI_API_KEY=your_openai_key
OPENAI_MODEL_CITIZEN_REPLY=gpt-4o-mini
OPENAI_MODEL_CLASSIFIER=gpt-4o-mini
OPENAI_MODEL_INTERNAL_DRAFT=gpt-4o-mini
OPENAI_MODEL_MODERATION=omni-moderation-latest

# Server
PORT=5002

# Assinatura final das mensagens ao cidadão (opcional). Aparece como última linha,
# depois do bloco de protocolo. Default embutido no código se não setar.
ASSINATURA_BOT=Muito obrigado! Seu chamado já foi registrado. Ivaté agradece sua participação.

# Rate limit (limites por número — valores padrão entre parênteses)
# DAILY_MSG_LIMIT: teto de mensagens por número por dia (25). Áudios também contam aqui.
# AUDIO_MAX_SECONDS: duração máxima de cada áudio aceito, em segundos (60).
# AUDIO_DAILY_LIMIT: teto de áudios por número por dia (10) — controla custo do Whisper.
# Outras camadas são fixas no código: burst 5 msgs/30s→cooldown 60s; média 10 msgs/10min;
# áudio 3/hora; volume 3000 chars/10min; global 100 msgs/min (todos os números).
DAILY_MSG_LIMIT=25
AUDIO_MAX_SECONDS=60
AUDIO_DAILY_LIMIT=10

# Dashboard Login
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=sua_senha_forte_aqui
FLASK_SECRET_KEY=gere_uma_chave_aleatoria_aqui

# Admin API
ADMIN_KEY=sua_chave_admin_aqui

# Webhook — validação de origem (mesmo valor configurado na Evolution API)
# O secret pode vir num header OU na query string da URL do webhook. Como a
# Evolution de Ivaté NÃO envia headers customizados, use a URL na Evolution:
#   https://ivate.nodedata.com.br/webhook?token=SEU_SECRET
# Rollout seguro em 2 estágios (NÃO ligue o enforce de cara):
#   1) Defina WEBHOOK_SECRET aqui e ponha ?token=... na URL da Evolution. Com o
#      enforce desligado, o servidor só registra "[WEBHOOK-AUTH] match" — aceita tudo.
#   2) Quando os logs confirmarem o match, ligue WEBHOOK_SECRET_ENFORCE=true para
#      passar a rejeitar (401) quem não mandar o secret correto.
# Rollback = remover WEBHOOK_SECRET_ENFORCE.
WEBHOOK_SECRET=sua_chave_webhook_aqui
WEBHOOK_SECRET_ENFORCE=false

# Números de teste (ocultos do painel da Prefeitura)
# Mensagens desses números são atendidas normalmente pela Clara (resposta real,
# protocolo, threading), mas os cards NÃO aparecem em nenhuma tela do painel.
# Útil para testar o bot/IA em produção sem poluir o painel. Separe por vírgula.
# O casamento é pelos últimos 8 dígitos (tolera o 9º dígito e prefixos 55/DDD).
# Ex.: TEST_NUMBERS=44991546866,44999998888
TEST_NUMBERS=
